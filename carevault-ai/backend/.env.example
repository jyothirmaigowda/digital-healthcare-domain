# CareVault AI Backend Configuration

# ═══════════════════════════════════════════════
# SERVER
# ═══════════════════════════════════════════════
PORT=5000
NODE_ENV=development

# ═══════════════════════════════════════════════
# DATABASE (MongoDB)
# ═══════════════════════════════════════════════

# Local MongoDB
# MONGODB_URI=mongodb://localhost:27017/carevault-ai

# MongoDB Atlas (Cloud)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/carevault-ai?retryWrites=true&w=majority

# ═══════════════════════════════════════════════
# JWT AUTHENTICATION
# ═══════════════════════════════════════════════
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRE=7d

# ═══════════════════════════════════════════════
# CORS & FRONTEND
# ═══════════════════════════════════════════════
FRONTEND_URL=http://localhost:3000

# ═══════════════════════════════════════════════
# FILE UPLOAD
# ═══════════════════════════════════════════════
MAX_FILE_SIZE=10485760  # 10 MB in bytes
UPLOAD_DIR=./uploads

# ═══════════════════════════════════════════════
# EMAIL (Optional - for future notifications)
# ═══════════════════════════════════════════════
# EMAIL_SERVICE=gmail
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASS=your-app-password

# ═══════════════════════════════════════════════
# API KEYS (Optional - for future AI services)
# ═══════════════════════════════════════════════
# OPENAI_API_KEY=your-openai-api-key
# HUGGING_FACE_API_KEY=your-hugging-face-key
